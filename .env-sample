# Existing deployment settings. Do not commit a real .env file or session.
MODE=private
PREFIXES=.
# Leave PORT commented on Katabump/Pterodactyl/Render/Koyeb/Heroku so panel SERVER_PORT / PORT is respected.
# PORT=3000

# Use either session variable. SESSION is base64(creds.json).
# SESSION_ID may be LIL~base64(gzip(creds.json)) from the current bot,
# or the same base64(creds.json) format accepted by SESSION.
SESSION=
SESSION_ID=

TZ=Africa/Nairobi
# Legacy variable accepted when TZ is not set:
TIME_ZONE=Africa/Nairobi

ANTICALL=off
ANTIDELETE=on
ANTIEDIT=on
AUTO_READ=off
# Blocks removals, demotions, and message deletion targeting group admins.
# Set to off only when the owner intentionally permits those actions.
ADMIN_PROTECTION=on
AUTO_REACT=off
# AUTO_REACT_MODE=all, groups, or dm; set AUTO_REACT=on to enable.
AUTO_REACT_MODE=all
# Optional comma-separated reaction emoji list.
AUTO_REACT_EMOJIS=🐾,⚡,💜
AUTO_VIEW=on
AUTO_LIKE=on
# Status emoji: use random for Toxic-MD style random reactions, or set one emoji such as ❤️.
STATUS_LIKE_EMOJI=random
# Legacy status settings are also accepted:
AUTO_READ_STATUS=true
AUTO_LIKE_STATUS=true

ALWAYS_ONLINE=off
DM_PRESENCE=
GRP_PRESENCE=

OWNER_NAME=Spider Man
BOT_NAME=Spider Man
BOT_PIC=https://raw.githubusercontent.com/LilGabrielDev/Spider-Man/main/spider/assets/spider-man.jpg
MENU_IMAGES=

CHANNEL_JID=
CHANNEL_URL=https://whatsapp.com/channel/0029VbDh88NCMY0Fartkxm1g
HOSTING_URL=https://cheap.bothosting.lilgabrieltech.top
# Optional override; leave empty to auto-detect hosting platform (Katabump, Panel, Heroku, Render, Koyeb, etc.)
HOSTING_PROVIDER=
GITHUB_REPO=LilGabrielDev/Spider-Man

# Optional credentials for migrated provider-backed features. Keep real values
# in the deployment secret manager; do not commit them in this file.
SPIDER_API_KEY=
SPIDER_API_URL=
GCSE_KEY=
TENORAPIKEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
GROQ_API_KEY=
GROQ_KEY_1=
GH_TOKEN=
GITHUB_TOKEN=
GITHUB_PERSONAL_ACCESS_TOKEN=
HEROKU_API_KEY=
SPIDER_LEGACY_DOWNLOADS_PINTEREST_API_KEY=
SPIDER_LEGACY_DOWNLOADS_PLAY_API_KEY=
SPIDER_LEGACY_DOWNLOADS_SHAZAM_ACCESS_KEY=
SPIDER_LEGACY_DOWNLOADS_SHAZAM_ACCESS_SECRET=
SPIDER_LEGACY_EDITING_TOANIME_API_KEY=
SPIDER_LEGACY_EDITING_TOGHIBLI_API_KEY=
